{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrideX site provisioning",
  "type": "object",
  "required": ["name", "location", "timezone"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 64},
    "location": {"type": "object", "required": ["lat", "lon"], "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}, "altitude_m": {"type": "number", "minimum": -500, "maximum": 5000}}},
    "timezone": {"type": "string", "pattern": "^[A-Za-z_]+/[A-Za-z_]+(/[A-Za-z_]+)?$"},
    "market": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "zone_eic": {"type": "string"}}},
    "pv": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "arrays": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "required": ["name", "kwp", "tilt", "azimuth"], "properties": {"name": {"type": "string"}, "kwp": {"type": "number", "minimum": 0.1, "maximum": 10000}, "tilt": {"type": "number", "minimum": 0, "maximum": 90}, "azimuth": {"type": "number", "minimum": -180, "maximum": 180}}}}}}
  }
}
