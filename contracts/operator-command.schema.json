{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridex.tech/contracts/operator-command.schema.json",
  "title": "GrideX protected battery operator command",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "actions", "requestedBy"],
  "properties": {
    "sequence": {"type": "integer", "minimum": 1, "maximum": 65535},
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["runState", "reactivePower", "socLimits"]}
    },
    "runState": {"type": "boolean"},
    "reactivePowerKvar": {"type": "number", "minimum": -3276.8, "maximum": 3276.7},
    "socUpperPct": {"type": "number", "minimum": 1, "maximum": 100},
    "socLowerPct": {"type": "number", "minimum": 0, "maximum": 99},
    "requestedBy": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "maxLength": 500}
  },
  "allOf": [
    {
      "if": {"properties": {"actions": {"contains": {"const": "runState"}}}},
      "then": {"required": ["runState"]}
    },
    {
      "if": {"properties": {"actions": {"contains": {"const": "reactivePower"}}}},
      "then": {"required": ["reactivePowerKvar"]}
    },
    {
      "if": {"properties": {"actions": {"contains": {"const": "socLimits"}}}},
      "then": {"required": ["socUpperPct", "socLowerPct"]}
    }
  ]
}
