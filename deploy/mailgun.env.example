GRIDEX_MAILGUN_REGION=EU
GRIDEX_MAILGUN_DOMAIN=mg.example.com
GRIDEX_MAILGUN_FROM="GrideX <noreply@example.com>"
# Use macOS Keychain with scripts/test-mailgun.mjs --keychain for host testing.
