# Render API_HOST/AUTH_HOST privately. No public OpenRemote or management routes.
# Попълни API_HOST/AUTH_HOST локално. Без публични OpenRemote/admin маршрути.
worker_processes auto;
pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
    server_tokens off;
    # Never log query strings, invitation tokens, authorization headers or bodies.
    # Без query параметри, invitation tokens, Authorization или тела в логовете.
    log_format safe '$remote_addr $request_method $uri $status';
    access_log /dev/stdout safe;
    error_log /dev/stderr warn;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    limit_req_zone $binary_remote_addr zone=per_client:10m rate=10r/s;
    limit_req_status 429;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /certs/fullchain.pem;
    ssl_certificate_key /certs/privkey.pem;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    add_header X-Content-Type-Options nosniff always;
    server {
        listen 8443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
        return 404;
    }
    server {
        listen 8443 ssl;
        server_name ${API_HOST};
        limit_req zone=per_client burst=40 nodelay;
        location /api/v1/ {
            proxy_pass http://gridex-api:8080/api/v1/;
        }
        location / { return 404; }
    }
    server {
        listen 8443 ssl;
        server_name ${AUTH_HOST};
        limit_req zone=per_client burst=40 nodelay;
        location /auth/realms/gridex/ {
            proxy_pass http://keycloak:8080/auth/realms/gridex/;
        }
        location /auth/resources/ {
            proxy_pass http://keycloak:8080/auth/resources/;
        }
        location / { return 404; }
    }
}
