# Render API_HOST/AUTH_HOST privately. The auth host also carries the scoped
# OpenRemote Manager surface; master/admin/health/metrics remain private.
# Попълни API_HOST/AUTH_HOST локално. Auth host има ограничен Manager достъп;
# master/admin/health/metrics остават непублични.
worker_processes auto;
pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
    # Re-resolve Docker service names after container recreation; never pin startup IPs.
    # Обновявай Docker DNS след пресъздаване; без фиксиране на стартовите IP адреси.
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 2s;
    server_tokens off;
    # Never log query strings, invitation tokens, authorization headers or bodies.
    # Без query параметри, invitation tokens, Authorization или тела в логовете.
    log_format safe '$remote_addr $request_method $uri $status';
    access_log /dev/stdout safe;
    error_log /dev/stderr warn;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    limit_req_zone $binary_remote_addr zone=per_client:10m rate=10r/s;
    limit_req_status 429;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /certs/fullchain.pem;
    ssl_certificate_key /certs/privkey.pem;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    add_header X-Content-Type-Options nosniff always;
    server {
        listen 8443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
        return 404;
    }
    server {
        listen 8443 ssl;
        server_name ${API_HOST};
        set $api_backend gridex-api:8080;
        limit_req zone=per_client burst=40 nodelay;
        location /api/v1/ {
            proxy_pass http://$api_backend;
        }
        location / { return 404; }
    }
    server {
        listen 8443 ssl;
        server_name ${AUTH_HOST};
        set $auth_backend keycloak:8080;
        limit_req zone=per_client burst=40 nodelay;
        # BEGIN GRIDEX PUBLIC MANAGER -- portal launch and per-request authorisation
        set $manager_backend manager:8080;
        set $api_backend gridex-api:8080;
        # The entry is exclusively through the authenticated GrideX portal.
        # No anonymous Manager HTML, assets, bootstrap or API escape hatch.
        location = /manager { return 404; }
        location = /manager/launch {
            limit_except GET { deny all; }
            proxy_pass http://$api_backend/internal/manager/consume?ticket=$arg_ticket;
        }
        location = /_manager_authorize {
            internal;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Original-URI $request_uri;
            proxy_pass http://$api_backend/internal/manager/check;
        }
        location = /manager/ {
            auth_request /_manager_authorize;
            limit_except GET { deny all; }
            proxy_pass http://$manager_backend;
        }
        location /manager/ {
            auth_request /_manager_authorize;
            limit_except GET { deny all; }
            proxy_pass http://$manager_backend;
        }
        location /shared/ {
            auth_request /_manager_authorize;
            limit_except GET { deny all; }
            proxy_pass http://$manager_backend;
        }
        # These two bootstrap responses are synthetic and never proxy master.
        # Тези два bootstrap отговора са синтетични и никога не proxy-ват master.
        location = /api/master/info {
            auth_request /_manager_authorize;
            limit_except GET { deny all; }
            proxy_set_header X-Original-URI $request_uri;
            proxy_pass http://$api_backend/internal/manager/info;
        }
        location = /api/master/configuration/manager {
            auth_request /_manager_authorize;
            limit_except GET { deny all; }
            proxy_set_header X-Original-URI $request_uri;
            proxy_pass http://$api_backend/internal/manager/config;
        }
        # Dynamic customer realm: the internal authorizer compares the exact
        # realm with the current session; master is denied separately.
        location ^~ /api/master/ { return 404; }
        location ~ "^/api/[a-z][a-z0-9-]{2,30}/asset/query$" {
            auth_request /_manager_authorize;
            limit_except POST { deny all; }
            proxy_pass http://$manager_backend;
        }
        location ~ "^/api/[a-z][a-z0-9-]{2,30}/(asset(/|$)|model(/|$)|map(/tile/[^/]+/[^/]+/[^/]+|/getCustomMapInfo)?$|realm/accessible$|user/(user|userRoles/openremote|userRealmRoles)$)" {
            auth_request /_manager_authorize;
            limit_except GET { deny all; }
            proxy_pass http://$manager_backend;
        }
        location = /websocket/events {
            auth_request /_manager_authorize;
            if ($http_origin != 'https://${AUTH_HOST}') { return 403; }
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Port 443;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Forwarded '';
            proxy_read_timeout 300s;
            proxy_pass http://$manager_backend;
        }
        # END GRIDEX PUBLIC MANAGER
        # Future provisioned realm login must work before the user has a
        # portal session. Reject master/admin explicitly; unknown slugs 404
        # at Keycloak. Only exact slug-shaped realm paths are forwarded.
        location = /auth/realms/master { return 404; }
        location ^~ /auth/realms/master/ { return 404; }
        location ~ "^/auth/realms/[a-z][a-z0-9-]{2,30}/" {
            proxy_pass http://$auth_backend;
        }
        location /auth/resources/ {
            proxy_pass http://$auth_backend;
        }
        location / { return 404; }
    }
}
