# Render API_HOST/AUTH_HOST privately. The auth host also carries the scoped
# OpenRemote Manager surface; master/admin/health/metrics remain private.
# Попълни API_HOST/AUTH_HOST локално. Auth host има ограничен Manager достъп;
# master/admin/health/metrics остават непублични.
worker_processes auto;
pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
    # Re-resolve Docker service names after container recreation; never pin startup IPs.
    # Обновявай Docker DNS след пресъздаване; без фиксиране на стартовите IP адреси.
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 2s;
    server_tokens off;
    # Never log query strings, invitation tokens, authorization headers or bodies.
    # Без query параметри, invitation tokens, Authorization или тела в логовете.
    log_format safe '$remote_addr $request_method $uri $status';
    access_log /dev/stdout safe;
    error_log /dev/stderr warn;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    limit_req_zone $binary_remote_addr zone=per_client:10m rate=10r/s;
    limit_req_status 429;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /certs/fullchain.pem;
    ssl_certificate_key /certs/privkey.pem;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    add_header X-Content-Type-Options nosniff always;
    server {
        listen 8443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
        return 404;
    }
    server {
        listen 8443 ssl;
        server_name ${API_HOST};
        set $api_backend gridex-api:8080;
        limit_req zone=per_client burst=40 nodelay;
        location /api/v1/ {
            proxy_pass http://$api_backend;
        }
        location / { return 404; }
    }
    server {
        listen 8443 ssl;
        server_name ${AUTH_HOST};
        set $auth_backend keycloak:8080;
        set $manager_backend manager:8080;
        limit_req zone=per_client burst=40 nodelay;
        # Scoped external Manager: authenticated gridex realm only.
        # Ограничен външен Manager: само автентикиран realm gridex.
        location = /manager { return 302 /manager/?realm=gridex; }
        location /manager/ {
            limit_except GET { deny all; }
            proxy_pass http://$manager_backend;
        }
        location /shared/ {
            limit_except GET { deny all; }
            proxy_pass http://$manager_backend;
        }
        # These two bootstrap responses are synthetic and never proxy master.
        # Тези два bootstrap отговора са синтетични и никога не proxy-ват master.
        location = /api/master/info {
            limit_except GET { deny all; }
            default_type application/json;
            return 200 '{"version":"1.30.0","authServerUrl":"/auth"}';
        }
        location = /api/master/configuration/manager {
            limit_except GET { deny all; }
            default_type application/json;
            return 200 '{"manager":{"realm":"gridex","clientId":"openremote","managerUrl":"https://${AUTH_HOST}","keycloakUrl":"https://${AUTH_HOST}/auth","consoleAutoEnable":false}}';
        }
        location = /api/gridex/asset/query {
            limit_except POST { deny all; }
            proxy_pass http://$manager_backend;
        }
        location ~ ^/api/gridex/(asset(/|$)|model(/|$)|map(/tile/[^/]+/[^/]+/[^/]+|/getCustomMapInfo)?$|realm/accessible$|user/(user|userRoles/openremote|userRealmRoles)$) {
            limit_except GET { deny all; }
            proxy_pass http://$manager_backend;
        }
        location = /websocket/events {
            if ($http_origin != 'https://${AUTH_HOST}') { return 403; }
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Port 443;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Forwarded '';
            proxy_read_timeout 300s;
            proxy_pass http://$manager_backend;
        }
        location /auth/realms/gridex/ {
            proxy_pass http://$auth_backend;
        }
        location /auth/resources/ {
            proxy_pass http://$auth_backend;
        }
        location / { return 404; }
    }
}
