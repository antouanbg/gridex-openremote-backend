OR_HOSTNAME=localhost
OR_ADMIN_PASSWORD=change-me-before-first-start
OR_SSL_PORT=443
MANAGER_VERSION=latest
KEYCLOAK_VERSION=latest
PROXY_VERSION=latest
POSTGRESQL_VERSION=latest-slim
OPENREMOTE_BASE_URL=https://openremote.example.invalid
OPENREMOTE_REALM=gridex
OPENREMOTE_SERVICE_CLIENT_ID=gridex-api
OPENREMOTE_SERVICE_CLIENT_SECRET=replace-with-a-confidential-client-secret
OIDC_ISSUER=https://identity.example.invalid/auth/realms/gridex
OIDC_AUDIENCE=gridex-portal
