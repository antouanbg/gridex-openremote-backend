OR_HOSTNAME=localhost
OR_ADMIN_PASSWORD=change-me-before-first-start
OR_SSL_PORT=443
MANAGER_VERSION=latest
KEYCLOAK_VERSION=latest
PROXY_VERSION=latest
POSTGRESQL_VERSION=latest-slim
OPENREMOTE_BASE_URL=https://openremote.example.invalid
OPENREMOTE_REALM=gridex
OPENREMOTE_SERVICE_CLIENT_ID=gridex-api
OPENREMOTE_SERVICE_CLIENT_SECRET=replace-with-a-confidential-client-secret
OIDC_ISSUER=https://identity.example.invalid/auth/realms/gridex
OIDC_AUDIENCE=gridex-portal
GRIDEX_API_PORT=8081
GRIDEX_ALLOWED_ORIGINS=https://portal.example.invalid
VPN_BIND_ADDRESS=replace-with-backend-wireguard-interface-address
GRIDEX_DATABASE_NAME=gridex
GRIDEX_DATABASE_USER=gridex
GRIDEX_DATABASE_PASSWORD=replace-with-a-long-random-password
GRIDEX_AUTO_MIGRATE=false
# Keep false until the commissioning gate is signed off.
GRIDEX_WRITES_ENABLED=false
# One private backend .env; never commit actual keys or recipients.
GRIDEX_MAILGUN_REGION=EU
GRIDEX_MAILGUN_DOMAIN=mg.example.com
GRIDEX_MAILGUN_FROM="GrideX <noreply@example.com>"
GRIDEX_MAILGUN_API_KEY=replace-with-private-sending-key
# Comma-separated blind copies; receives sensitive account action links too.
GRIDEX_MAILGUN_BCC=support@example.com
GRIDEX_ENROLLMENT_ENABLED=false
# Portal sessions must reauthenticate after API restart (single-instance policy).
# Portal сесиите изискват нов вход след API рестарт (един API instance).
GRIDEX_REAUTH_ON_API_RESTART=false
# Persistent Remember Me sessions; never a non-expiring browser token.
# Постоянна Remember Me сесия, не безсрочен browser token.
GRIDEX_REMEMBER_SESSION_DAYS=365
GRIDEX_DEVICE_VAULT_DIRECTORY=/var/lib/gridex-device-vault
GRIDEX_DEVICE_VAULT_KEY_FILE=/run/gridex-device-vault/master.key
GRIDEX_ENROLLMENT_CLIENT_SECRET=replace-with-dedicated-client-secret
GRIDEX_PUBLIC_AUTH_BASE=https://auth.example.com/auth
GRIDEX_ADMIN_AUTH_BASE=https://localhost:8443/auth
GRIDEX_PORTAL_ORIGIN=https://portal.example.com
# Device liveness: one private backend env; never commit real bindings.
# Статус на устройства: един частен backend env, без реални bindings в Git.
GRIDEX_HEARTBEAT_STALE_SECONDS=30
GRIDEX_HEARTBEAT_OFFLINE_SECONDS=90
GRIDEX_MQTT_URL=mqtts://broker:8883
GRIDEX_MQTT_TOPIC_PREFIX=gridex/v1
GRIDEX_MQTT_NETWORK=gridex-mqtt_mqtt
GRIDEX_MQTT_READER_DIRECTORY=/private/runtime/mqtt-reader
GRIDEX_HEARTBEAT_BINDINGS=[]
