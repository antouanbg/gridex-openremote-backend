OR_HOSTNAME=localhost
OR_ADMIN_PASSWORD=change-me-before-first-start
OR_SSL_PORT=443
MANAGER_VERSION=latest
KEYCLOAK_VERSION=latest
PROXY_VERSION=latest
POSTGRESQL_VERSION=latest-slim
OPENREMOTE_BASE_URL=https://openremote.example.invalid
OPENREMOTE_REALM=gridex
OPENREMOTE_SERVICE_CLIENT_ID=gridex-api
OPENREMOTE_SERVICE_CLIENT_SECRET=replace-with-a-confidential-client-secret
OIDC_ISSUER=https://identity.example.invalid/auth/realms/gridex
OIDC_AUDIENCE=gridex-portal
GRIDEX_API_PORT=8081
GRIDEX_ALLOWED_ORIGINS=https://portal.example.invalid
VPN_BIND_ADDRESS=replace-with-backend-wireguard-interface-address
GRIDEX_DATABASE_NAME=gridex
GRIDEX_DATABASE_USER=gridex
GRIDEX_DATABASE_PASSWORD=replace-with-a-long-random-password
GRIDEX_AUTO_MIGRATE=false
# Keep false until the commissioning gate is signed off.
GRIDEX_WRITES_ENABLED=false
GRIDEX_CONFIG_WORKER_POLL_MS=2000
GRIDEX_CONFIG_WORKER_LEASE_SECONDS=60
GRIDEX_CONFIG_WORKER_MAX_ATTEMPTS=8
# VPN-only MQTT listener; do not use a public endpoint or store real credentials here.
GRIDEX_MQTT_URL=mqtts://mqtt-vpn.example.invalid:8883
GRIDEX_MQTT_USERNAME=replace-with-worker-identity
GRIDEX_MQTT_PASSWORD=replace-with-worker-secret
GRIDEX_MQTT_CLIENT_ID=gridex-edge-health-worker
GRIDEX_MQTT_TOPIC_PREFIX=gridex/v1
GRIDEX_EDGE_HEALTH_STALE_SECONDS=30
GRIDEX_EDGE_HEALTH_OFFLINE_SECONDS=90
