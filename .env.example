OR_HOSTNAME=localhost
OR_ADMIN_PASSWORD=change-me-before-first-start
OR_SSL_PORT=443
MANAGER_VERSION=latest
KEYCLOAK_VERSION=latest
PROXY_VERSION=latest
POSTGRESQL_VERSION=latest-slim
OPENREMOTE_BASE_URL=https://ems.gridex.tech
OPENREMOTE_REALM=gridex
GRIDEX_API_PORT=8081
GRIDEX_ALLOWED_ORIGINS=https://gridex.tech,https://app.gridex.tech
GRIDEX_SITE_MAP_JSON={}
# Keep false until the commissioning gate is signed off.
GRIDEX_WRITES_ENABLED=false

# Data services: secrets/infrastructure only. Site coordinates, zones and PV
# arrays are discovered from OpenRemote asset attributes.
ENTSOE_TOKEN=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=
OPEN_METEO_INTERVAL_MIN=60
DATA_DB_DSN=postgresql://gridex_data:CHANGE_ME@postgresql:5432/gridex_data
OR_URL=http://manager:8080
OR_REALMS=master
OR_CLIENT_ID=gridex-data-services
OR_CLIENT_SECRET=
DISCOVERY_INTERVAL_MIN=5
DEFAULT_TZ=UTC
